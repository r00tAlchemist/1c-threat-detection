<group name="1c,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">1c</field>
    <description>1С: событие журнала регистрации</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="ev.id" type="pcre2">^_\$Session\$_\.AuthenticationError$</field>
    <description>1С: неудачный вход</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <description>1С: подбор пароля - 5 неудачных входов за 60 с</description>
    <mitre><id>T1110.001</id></mitre>
  </rule>

  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="ev.id" type="pcre2">^_\$User\$_\.New$</field>
    <description>1С: создан пользователь информационной базы</description>
    <mitre><id>T1136.001</id></mitre>
    <group>adduser,</group>
  </rule>

  <rule id="100104" level="7">
    <if_sid>100100</if_sid>
    <field name="ev.id" type="pcre2">^_\$InfoBase\$_\.ConfigUpdate$</field>
    <description>1С: изменена конфигурация информационной базы</description>
    <mitre><id>T1505</id></mitre>
  </rule>

  <rule id="100105" level="3">
    <if_sid>100100</if_sid>
    <field name="ev.id" type="pcre2">^_\$Session\$_\.Authentication$</field>
    <description>1С: успешный вход</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100106" level="12" timeframe="120">
    <if_matched_sid>100102</if_matched_sid>
    <if_sid>100105</if_sid>
    <description>1С: успешный вход после подбора пароля</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_success,</group>
  </rule>
</group>

<!-- Нужен аудит создания процессов (Security 4688) с командной строкой -->
<!-- w3wp.exe - веб-публикация 1С в IIS: при работе через веб-клиент серверный код выполняется в пуле приложений -->
<group name="1c,windows,">
  <rule id="100107" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)\\(1cv8[a-z]*|rphost|w3wp)\.exe$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|schtasks|whoami|net1?)\.exe$</field>
    <description>1С: $(win.eventdata.parentProcessName) запустил $(win.eventdata.newProcessName) - выполнение кода из обработки</description>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- Вывод команды перенаправлен в файл: обработка читает результат обратно в 1С.
       В eventchannel символ > приходит как &gt;, поэтому ищем оба варианта -->
  <rule id="100108" level="14">
    <if_sid>100107</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(\x3e|\x26gt;)</field>
    <description>1С: команда из обработки с выводом в файл - $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.003</id></mitre>
  </rule>

  <!-- Процесс, запущенный оболочкой, которую до этого запустила 1С, в том же сеансе входа -->
  <rule id="100109" level="12" timeframe="600">
    <if_matched_sid>100107</if_matched_sid>
    <if_sid>67027</if_sid>
    <same_field>win.eventdata.subjectLogonId</same_field>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)\\(cmd|powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.newProcessName" type="pcre2" negate="yes">(?i)\\conhost\.exe$</field>
    <description>1С: в оболочке, запущенной из 1С, выполнен $(win.eventdata.commandLine)</description>
    <mitre><id>T1059</id></mitre>
  </rule>
</group>
